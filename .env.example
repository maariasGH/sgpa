POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
JWT_SECRET=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
# Solo con NODE_ENV=development y de al menos 32 caracteres (ej: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
DEBUG_TOKEN=
DEBUG_TOKEN_OP=
VITE_API_URL=
CORS_ORIGIN=
# Email (Nodemailer, ms-autoridades). Vacío = los emails solo se muestran en consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opcional: a dónde llegan las respuestas de los destinatarios
SMTP_REPLY_TO=
# Contacto que figura al pie de los emails a operadores (alta / baja / reactivación)
SOPORTE_EMAIL=

# CORS: orígenes permitidos, separados por coma.
# En desarrollo (NODE_ENV=development) cualquier origen de la red local ya se acepta solo,
# así que el teléfono funciona sin agregar la IP de la PC.
CORS_ORIGIN=http://localhost:5173
# URL opcional del gateway; vacía usa el proxy local de Vite para /api
VITE_API_URL=
# Tamaño máximo de la grabación (MP4) de una audiencia, en MB
VIDEO_MAX_MB=2048
